  "components": {
    "schemas": {
      "Body_cv_match_api_cv_match_post": {
        "properties": {
          "file": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "File",
            "description": "PDF or .txt CV, max 2 MB"
          },
          "cv_text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20000
              },
              {
                "type": "null"
              }
            ],
            "title": "Cv Text"
          },
          "store_profile": {
            "type": "boolean",
            "title": "Store Profile",
            "description": "Opt in to store the structured profile",
            "default": false
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 8
          }
        },
        "type": "object",
        "title": "Body_cv_match_api_cv_match_post"
      },
      "CandidateProfile": {
        "properties": {
          "headline": {
            "type": "string",
            "maxLength": 200,
            "title": "Headline",
            "default": ""
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 60,
            "title": "Skills"
          },
          "years_experience": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 60.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Years Experience"
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/LanguageSkill"
            },
            "type": "array",
            "title": "Languages"
          },
          "education": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Education"
          },
          "preferred_cities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Preferred Cities"
          },
          "target_roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Target Roles"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CandidateProfile",
        "description": "Structured CV profile (no names, contact data or raw CV text)."
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{8,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "CvMatch": {
        "properties": {
          "posting": {
            "$ref": "#/components/schemas/PostingSummary"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "gaps": {
            "$ref": "#/components/schemas/GapResult"
          }
        },
        "type": "object",
        "required": [
          "posting",
          "score",
          "explanation",
          "gaps"
        ],
        "title": "CvMatch"
      },
      "CvMatchResponse": {
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/CandidateProfile"
          },
          "matches": {
            "items": {
              "$ref": "#/components/schemas/CvMatch"
            },
            "type": "array",
            "title": "Matches"
          },
          "stored_profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stored Profile Id"
          },
          "privacy": {
            "type": "string",
            "title": "Privacy",
            "default": "Your CV was processed in memory and not stored."
          }
        },
        "type": "object",
        "required": [
          "profile",
          "matches"
        ],
        "title": "CvMatchResponse"
      },
      "DemoKey": {
        "properties": {
          "api_key": {
            "type": "string",
            "title": "Api Key"
          },
          "expires_in_hours": {
            "type": "integer",
            "title": "Expires In Hours",
            "default": 24
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": "Demo key with strict rate limits. Shown once; keep it private."
          }
        },
        "type": "object",
        "required": [
          "api_key"
        ],
        "title": "DemoKey"
      },
      "FeedbackIn": {
        "properties": {
          "trace_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "message_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Id"
          },
          "question": {
            "type": "string",
            "maxLength": 2000,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 8000,
            "title": "Answer"
          },
          "rating": {
            "type": "integer",
            "enum": [
              -1,
              1
            ],
            "title": "Rating"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer",
          "rating"
        ],
        "title": "FeedbackIn"
      },
      "FeedbackOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "recorded"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "FeedbackOut"
      },
      "Gap": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "skill",
              "german",
              "years",
              "location",
              "bluecard"
            ],
            "title": "Kind"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor"
            ],
            "title": "Severity"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "detail",
          "severity"
        ],
        "title": "Gap"
      },
      "GapResult": {
        "properties": {
          "posting_id": {
            "type": "string",
            "title": "Posting Id"
          },
          "matched_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Skills"
          },
          "missing_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Skills"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/Gap"
            },
            "type": "array",
            "title": "Gaps"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "posting_id",
          "matched_skills",
          "missing_skills",
          "gaps",
          "summary"
        ],
        "title": "GapResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LanguageSkill": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language"
          },
          "level": {
            "type": "string",
            "enum": [
              "basic",
              "good",
              "fluent",
              "native",
              "unspecified"
            ],
            "title": "Level",
            "default": "unspecified"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "language"
        ],
        "title": "LanguageSkill"
      },
      "PostingDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "company": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Company"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "remote_policy": {
            "type": "string",
            "title": "Remote Policy"
          },
          "seniority": {
            "type": "string",
            "title": "Seniority"
          },
          "min_years_experience": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Years Experience"
          },
          "english_sufficient": {
            "type": "string",
            "title": "English Sufficient"
          },
          "german_level": {
            "type": "string",
            "title": "German Level"
          },
          "bluecard_status": {
            "type": "string",
            "title": "Bluecard Status"
          },
          "visa_sponsorship": {
            "type": "string",
            "title": "Visa Sponsorship"
          },
          "relocation_support": {
            "type": "string",
            "title": "Relocation Support"
          },
          "salary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary"
          },
          "required_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Skills"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet",
            "default": ""
          },
          "last_checked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Checked At"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "nice_to_have_skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Nice To Have Skills",
            "default": []
          },
          "languages_required": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Languages Required",
            "default": []
          },
          "contract_type": {
            "type": "string",
            "title": "Contract Type",
            "default": "unknown"
          },
