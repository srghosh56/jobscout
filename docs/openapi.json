{
  "openapi": "3.1.0",
  "info": {
    "title": "JobScout API",
    "description": "JobScout API: search skilled jobs in Germany for international candidates.\n\nAuthentication: send `X-API-Key: <key>` (or `Authorization: Bearer <key>`). Get a\nrate-limited demo key from `POST /api/demo-key`. Blue Card output is indicative, not legal\nadvice. Posting texts are never returned in full; follow `url` to the original ad.",
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/demo-key": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Demo Key",
        "operationId": "demo_key_api_demo_key_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoKey"
                }
              }
            }
          }
        }
      }
    },
