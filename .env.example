# ==========================================
# LLM & Embedding Configuration
# ==========================================
# Provider: ollama (local, free, private) | mistral | gemini
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Models installed in local Ollama
CHAT_MODEL=mistral:latest
JUDGE_MODEL=mistral:latest
EMBED_MODEL=bge-m3:latest

# Cloud API Keys (optional / left empty for local Ollama use)
MISTRAL_API_KEY=
GEMINI_API_KEY=

# ==========================================
# Database (docker compose defaults; change for Neon)
# ==========================================
# DATABASE_URL=postgresql+asyncpg://jobscout:jobscout@localhost:55433/jobscout
# READONLY_DATABASE_URL=postgresql+asyncpg://jobscout_ro:jobscout_ro@localhost:55433/jobscout

# ==========================================
# Optional switches
# ==========================================
# AGENT_MODE=single            # single | supervisor
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# RERANKER_ENABLED=true
